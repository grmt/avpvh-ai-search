{
  "name": "workspace-ai-search",
  "version": "2.1.4.33",
  "private": true,
  "description": "Development tooling for the Workspace AI Search WordPress plugin",
  "scripts": {
    "lint": "npm run lint:js",
    "lint:js": "eslint assets/*.js assets/js/*.js tests/e2e/*.js",
    "e2e:env:start": "wp-env start",
    "e2e:env:stop": "wp-env stop",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.js",
    "test:e2e:headed": "playwright test -c tests/e2e/playwright.config.js --headed",
    "test:e2e:ui": "playwright test -c tests/e2e/playwright.config.js --ui",
    "test:e2e:report": "playwright show-report playwright-report"
  },
  "engines": {
    "node": ">=24",
    "npm": "^11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@wordpress/env": "^10.30.0",
    "eslint": "^10.15.0"
  }
}
